# ============================================
# Grokati Bot — Environment Configuration
# Copy this file to .env and fill in real values
# ============================================

# --- Mode ---
# dry-run is the safe default. Set to "true" only when you are ready
# for the bot to write into the website content folder (and later post).
LIVE_MODE=false

# --- X (Twitter) API v2 ---
# Create a project/app at https://developer.x.com
# Required scopes: tweet.read, users.read (and tweet.write later for live posting)
X_BEARER_TOKEN=your_x_bearer_token_here
# Optional for posting later:
# X_API_KEY=
# X_API_SECRET=
# X_ACCESS_TOKEN=
# X_ACCESS_TOKEN_SECRET=

# --- xAI / Grok API ---
# Get key at https://console.x.ai
XAI_API_KEY=your_xai_api_key_here
# Optional: override base URL if needed
# XAI_BASE_URL=https://api.x.ai/v1
XAI_MODEL=grok-4-latest

# --- Monitoring settings ---
# Official accounts to watch (comma-separated, without @)
WATCH_ACCOUNTS=grok,xai,cursor_ai,bot,mattyp,leerob,Baconbrix,LouiseGiam
# Also watch Elon but only keep posts that mention Grok/xAI keywords
WATCH_ELON=true

# Keywords that raise signal (used for filtering + limited search)
HIGH_SIGNAL_KEYWORDS=Grok 4,Grok-4,Grok 4.,model release,API update,announcement,Grok Bot,Grok Build,xAI

# How many recent posts to fetch per account (keep low for Phase 1)
POSTS_PER_ACCOUNT=10

# --- Paths ---
# Where dry-run output is written (relative to bot/)
OUTPUT_DIR=output
# When LIVE_MODE=true, articles are also copied here (relative to project root)
WEBSITE_ARTICLES_DIR=../website/src/content/articles

# --- Logging ---
LOG_LEVEL=INFO





