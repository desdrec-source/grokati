---
import BaseLayout from './BaseLayout.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, pubDate, source, sourceUrl, author, image, imageAlt } = article.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const imageUrl = image
  ? image.startsWith('http')
    ? image
    : new URL(image, Astro.site).toString()
  : undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: pubDate.toISOString(),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': pageUrl,
  },
  author: {
    '@type': 'Organization',
    name: author || 'Grokati',
    url: Astro.site?.toString() || 'https://www.grokati.com',
  },
  publisher: {
    '@type': 'Organization',
    name: 'Grokati',
    url: Astro.site?.toString() || 'https://www.grokati.com',
  },
  isBasedOn: sourceUrl,
  ...(imageUrl
    ? {
        image: {
          '@type': 'ImageObject',
          url: imageUrl,
          description: imageAlt || title,
        },
      }
    : {}),
};
---

<BaseLayout
  title={title}
  description={description}
  ogType="article"
  image={image}
  imageAlt={imageAlt || title}
>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <article>
    <header class="article-header">
      <h1>{title}</h1>
      <div class="article-meta">
        <time datetime={pubDate.toISOString()}>{formattedDate}</time>
        <span>·</span>
        <span>{author}</span>
      </div>
    </header>

    {image && (
      <figure class="article-hero">
        <img
          src={image}
          alt={imageAlt || title}
          width="1200"
          height="630"
          loading="eager"
          decoding="async"
        />
      </figure>
    )}

    <div class="article-source">
      <strong>Source:</strong> {source}<br />
      <a href={sourceUrl} target="_blank" rel="noopener noreferrer">{sourceUrl}</a>
    </div>

    <div class="article-body">
      <slot />
    </div>

    <footer class="attribution">
      <p>
        This article was generated with AI assistance and is based solely on the cited source material.
        Grokati prioritizes accuracy and clear attribution. No details are invented.
      </p>
    </footer>
  </article>
</BaseLayout>