---
import type { CollectionEntry } from 'astro:content';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, pubDate, source, category, image, imageAlt } = article.data;

const formattedDate = pubDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'short',
  day: 'numeric',
});

const categoryLabels: Record<string, string> = {
  models: 'Models',
  imagine: 'Imagine',
  bot: 'Grok Bot',
  build: 'Grok Build',
  voice: 'Voice',
};
---

<article class={`article-card${image ? ' has-image' : ''}`}>
  <a href={`/articles/${article.id}`}>
    {image && (
      <div class="card-image">
        <img src={image} alt={imageAlt || title} width="600" height="315" loading="lazy" decoding="async" />
      </div>
    )}
    <div class="card-body">
      <div class="card-meta-row">
        <time class="card-date" datetime={pubDate.toISOString()}>{formattedDate}</time>
        {category && (
          <span class={`card-category cat-${category}`}>{categoryLabels[category] || category}</span>
        )}
      </div>
      <h2 class="card-title">{title}</h2>
      <p class="card-desc">{description}</p>
      <p class="card-source">Source: {source}</p>
    </div>
  </a>
</article>