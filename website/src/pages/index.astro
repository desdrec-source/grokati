---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';

/** Homepage shows only recent high-signal items. Older pieces live on /archive. */
const ARCHIVE_DAYS = 30;

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles.sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const cutoff = new Date();
cutoff.setUTCDate(cutoff.getUTCDate() - ARCHIVE_DAYS);
cutoff.setUTCHours(0, 0, 0, 0);
const cutoffMs = cutoff.valueOf();

const recent = articles.filter((a) => a.data.pubDate.valueOf() >= cutoffMs);
const olderCount = articles.length - recent.length;

const pinned = recent.find((a) => a.data.featured === true);
const featured = pinned ?? recent[0] ?? null;
const rest = recent.filter((a) => a.id !== featured?.id);

const categoryOrder = ['imagine', 'bot', 'build', 'voice', 'models'] as const;
const categoryLabels: Record<string, string> = {
  models: 'Models',
  imagine: 'Imagine',
  bot: 'Grok Bot',
  build: 'Grok Build',
  voice: 'Voice',
};

const grouped = categoryOrder
  .map((cat) => ({
    key: cat,
    label: categoryLabels[cat],
    items: rest.filter((a) => (a.data.category || 'models') === cat),
  }))
  .filter((g) => g.items.length > 0);

const featuredCategory = featured
  ? categoryLabels[featured.data.category || 'models'] || 'Models'
  : '';
const featuredDate = featured
  ? featured.data.pubDate.toLocaleDateString('en-US', {
      year: 'numeric',
      month: 'short',
      day: 'numeric',
    })
  : '';
---

<BaseLayout title="Grokati" description="High-signal, accurate news about Grok and xAI. Accuracy over volume.">
  <section class="home-hero">
    <p class="home-kicker">Grok &amp; xAI news</p>
    <h1 class="page-title">Latest updates</h1>
    <p class="page-subtitle muted">
      Focused coverage of official announcements and high-signal developments.
    </p>
  </section>

  {featured && (
    <section class="featured-section">
      <p class="featured-label">Featured</p>
      <a class="featured-card" href={`/articles/${featured.id}`}>
        <div class="featured-meta">
          <time datetime={featured.data.pubDate.toISOString()}>{featuredDate}</time>
          <span class="featured-cat">{featuredCategory}</span>
        </div>
        <h2 class="featured-title">{featured.data.title}</h2>
        {featured.data.image && (
          <div class="featured-image">
            <img
              src={featured.data.image}
              alt={featured.data.imageAlt || featured.data.title}
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
            />
          </div>
        )}
        <p class="featured-desc">{featured.data.description}</p>
        <p class="featured-source">Source: {featured.data.source}</p>
      </a>
    </section>
  )}

  {recent.length === 0 ? (
    <p class="muted">No recent articles in the last {ARCHIVE_DAYS} days.</p>
  ) : (
    grouped.map((group) => (
      <section class={`category-section cat-${group.key}`}>
        <div class="category-header">
          <h2 class="category-title">{group.label}</h2>
          <span class="category-count">{group.items.length}</span>
        </div>
        <div class="articles-grid">
          {group.items.map((article) => (
            <ArticleCard article={article} />
          ))}
        </div>
      </section>
    ))
  )}

  {olderCount > 0 && (
    <p class="archive-note muted">
      Showing the last {ARCHIVE_DAYS} days.
      <a href="/archive">{olderCount} older article{olderCount === 1 ? '' : 's'} → Archive</a>
    </p>
  )}
</BaseLayout>
