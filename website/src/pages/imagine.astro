---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Imagine" description="What Grok Imagine is: xAI image and video generation and editing tools.">
  <section class="about-content">
    <p class="home-kicker" style="margin-bottom: 0.75rem;">Products</p>
    <h1 class="page-title">Imagine</h1>
    <p class="page-subtitle muted">Image and video generation and editing in the Grok product line.</p>
    <p><strong>Imagine</strong> is xAI's media generation surface inside Grok, including image tools such as <strong>Imagine Image 2.0</strong> and related video updates.</p>
    <h2>What Imagine is for</h2>
    <ul>
      <li>Generating images from prompts</li>
      <li>Editing and refining generated images</li>
      <li>Video-related generation features where xAI has announced them</li>
    </ul>
    <p class="muted" style="margin-top: 2rem;"><a href="/products">← All products</a></p>
  </section>
</BaseLayout>